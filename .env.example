# Environment variables required for the browser-side app.
# Add these in your Vercel project settings (Project > Settings > Environment Variables).
# Use the values from your Supabase project: Project Settings > API.

# Public Supabase project URL, e.g. https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_URL=

# Public anon/publishable key (safe for the browser). NOT the service_role key.
VITE_SUPABASE_ANON_KEY=
